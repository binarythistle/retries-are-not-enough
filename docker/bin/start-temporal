#!/bin/bash
# Start the Temporal dev server.
#
#   start-temporal            idempotent; returns at once if already healthy
#   start-temporal --fresh    wipe all Temporal state first, then start
#
# Plain mode is idempotent on purpose: only the first caller does any work, so
# switching between challenges costs nothing.
#
# --fresh is what the per-challenge setup scripts actually use, and it exists
# for two reasons. The second matters more than the first.
#
#  1. Check scripts assert on a known workflow id. A completed ticket-1041 left
#     behind by the previous challenge makes the next challenge's check pass
#     before the attendee has done anything at all.
#  2. The Temporal UI tab starts empty, so the attendee sees exactly one
#     workflow rather than an accumulating pile from earlier chapters.
#
# The cost is real and was accepted deliberately: every Temporal challenge now
# pays a full server start instead of finding a healthy one. A few seconds on
# each challenge entry rather than once for the track.
#
# --ip 0.0.0.0 is load-bearing. Instruqt's service tab proxies into the sandbox
# from outside the container's loopback. Bound to 127.0.0.1 the Web UI is
# invisible to the tab and the attendee sees an empty frame. This is the same
# reason mock_llm.py cannot be a service tab: it binds 127.0.0.1.
set -uo pipefail

ADDRESS="127.0.0.1:7233"
UI="http://127.0.0.1:8233/"
LOG=/root/temporal-server.log
DB=/root/temporal.db

# Reject anything that is not --fresh rather than ignoring it. A typo would
# silently skip the wipe, and the symptom of that is a check script passing
# when it should not — which is the exact bug --fresh exists to prevent, and
# one of the harder ones to spot from the outside.
if [ $# -gt 0 ]; then
  if [ "$1" != "--fresh" ] || [ $# -gt 1 ]; then
    echo "usage: start-temporal [--fresh]" >&2
    exit 2
  fi

  # SQLite leaves -wal and -shm alongside the main file. Deleting only
  # temporal.db can leave the server recovering the state you meant to discard.
  pkill -f "temporal server start-dev" || true
  sleep 2
  rm -f "$DB" "$DB-wal" "$DB-shm"
  : > "$LOG"
fi

# Wait for the Web UI to actually serve, not just the frontend to be healthy.
#
# These are two different servers and the UI comes up a beat behind the
# frontend. Waiting only on cluster health returns "healthy" while the UI still
# 500s, and Instruqt's service tab hits the UI the moment the challenge
# renders. The attendee sees an error and has to know to refresh, which in a
# room of 30 is 30 people who do not.
wait_for_ui() {
  for _ in $(seq 1 60); do
    if curl -sf -o /dev/null --max-time 2 "$UI"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

if temporal operator cluster health --address "$ADDRESS" >/dev/null 2>&1; then
  if wait_for_ui; then
    echo "temporal dev server already healthy, Web UI serving"
    exit 0
  fi
  echo "frontend is healthy but the Web UI on :8233 is not serving" >&2
  tail -n 30 "$LOG" >&2
  exit 1
fi

# State is a SQLite file, per-attendee and per-sandbox, discarded on teardown.
# Nothing shared, nothing to provision, no namespace collisions between
# attendees.
nohup temporal server start-dev \
  --ip 0.0.0.0 \
  --db-filename "$DB" \
  --log-level warn \
  >> "$LOG" 2>&1 &

# The health wait matters. Without it the first command in a challenge races
# the dev server and fails intermittently under load.
for _ in $(seq 1 60); do
  if temporal operator cluster health --address "$ADDRESS" >/dev/null 2>&1; then
    if wait_for_ui; then
      echo "temporal dev server healthy on ${ADDRESS}, Web UI serving on :8233"
      exit 0
    fi
    echo "frontend came up but the Web UI on :8233 never served" >&2
    tail -n 30 "$LOG" >&2
    exit 1
  fi
  sleep 1
done

echo "temporal dev server did not become healthy within 60s" >&2
tail -n 30 "$LOG" >&2
exit 1
